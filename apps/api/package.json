{
  "name": "@emissions/api",
  "version": "1.0.0",
  "private": true,
  "description": "Emissions ingestion & analytics API",
  "scripts": {
    "build": "pnpm --filter @emissions/contracts build && nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "db:verify": "tsx --env-file-if-exists=../../.env src/db/verify.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@emissions/contracts": "workspace:*",
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.29",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
