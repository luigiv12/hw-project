# === App ===
NODE_ENV=development
PORT=3000

# === Postgres (docker-compose) ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=emissions
POSTGRES_USER=emissions
POSTGRES_PASSWORD=emissions

# Works for Prisma/Drizzle/pg:
DATABASE_URL=postgresql://emissions:emissions@localhost:5432/emissions

# === Redis (optional) ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# === pgAdmin (optional, only if running with --profile tools) ===
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# === API settings ===
#
# Every one of these has a working default in apps/api/src/config/env.ts, which
# is why they are commented out — the defaults are what `docker compose up`
# uses, and uncommenting one pins it. Listed so the knobs are discoverable
# without reading the schema.

# Browsers are refused any origin not on this list. Comma-separated, no
# wildcard: the API accepts writes, and `*` on a write surface is a habit worth
# not forming even on a demo.
# CORS_ORIGINS=http://localhost:3001

# How often the outbox dispatcher looks for undelivered events, in ms.
# OUTBOX_POLL_MS=1000

# Where the outbox delivers. Unset means log-only, which is the default locally
# and on the demo — the guarantee under test is that delivery is attempted
# exactly according to the outbox, not that a particular downstream exists.
# ALERTING_WEBHOOK_URL=https://example.com/alerts

# Requests per window per client IP, and the window in ms.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_TTL_MS=60000

# Number of reverse proxies in front of this process. Rate limiting buckets by
# client IP, and behind a proxy every request arrives from the proxy's address,
# so without this the whole internet shares one bucket. Set it to the real hop
# count — 1 behind Railway, Fly, or a single nginx. It defaults to 0 because
# trusting a hop that does not exist lets any caller spoof X-Forwarded-For.
# TRUST_PROXY_HOPS=0

# Bearer token required to scrape /metrics. Unset leaves it open, which is right
# for local work and for a demo whose README invites you to curl it, and wrong
# for an operational deployment — the exposition describes ingest volume, site
# count and error rates.
# METRICS_TOKEN=

